/** @var \Gtstudio\AiDashboard\Block\Adminhtml\Dashboard $aiBlock */
$aiBlock    = $block->getChildBlock('ai_ui');

/** @var \Magento\Backend\Block\Dashboard\Sales|null $salesBlock */
$salesBlock = $block->getChildBlock('sales');
$totals     = $salesBlock ? $salesBlock->getTotals() : [];

// Index totals by label key for direct access
$lifetimeSales = null;
$avgOrder      = null;
foreach ($totals as $total) {
    $lc = strtolower((string) ($total['label'] ?? ''));
    if (str_contains($lc, 'lifetime')) {
        $lifetimeSales = $total;
    } elseif (str_contains($lc, 'average')) {
        $avgOrder = $total;
    }
}
