<?xml version="1.0"?>
<!--
    Overrides the stock Magento admin dashboard by swapping only the template
    on the existing "dashboard" block, so all its children (totals, sales, grids,
    lastSearches, topSearches) remain available and provide their data as usual.
    Chart-only blocks are removed since we have our own charting.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <update handle="aidashboard_assets"/>

    <body>
        <referenceBlock name="dashboard" template="Gtstudio_AiDashboard::dashboard/index.phtml">
            <block class="Gtstudio\AiDashboard\Block\Adminhtml\Dashboard"
                   name="aidashboard.main"
                   as="ai_ui"/>
        </referenceBlock>
        <referenceBlock name="page.main.actions" remove="true"/>
        <referenceBlock name="analytics_service_external_link" remove="true"/>
        <referenceBlock name="dashboard.chart.disabled"  remove="true"/>
        <referenceBlock name="dashboard.diagrams"        remove="true"/>
        <referenceBlock name="dashboard.diagrams.period" remove="true"/>
        <referenceBlock name="dashboard.lastOrders" remove="true"/>
    </body>
</page>
